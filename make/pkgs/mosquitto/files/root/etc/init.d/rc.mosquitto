#!/bin/sh

DAEMON=mosquitto
DAEMON_LONG_NAME=Mosquitto
MODPATH=/mod/etc
CONF=$MODPATH/$DAEMON.conf
PID_FILE=/var/run/$DAEMON/$DAEMON.pid
. /etc/init.d/modlibrc

config() {
	if [ "$MOSQUITTO_ALLOW_ANONYMOUS" != "yes" ]; then
		# The firmware password file is root-only; the broker reads it as nobody.
		(
			umask 077
			cp /etc/default.mosquitto/passwd "$MODPATH/$DAEMON.passwd.tmp" &&
			chmod 600 "$MODPATH/$DAEMON.passwd.tmp" &&
			chown nobody:nobody "$MODPATH/$DAEMON.passwd.tmp" &&
			mv -f "$MODPATH/$DAEMON.passwd.tmp" "$MODPATH/$DAEMON.passwd"
		) || exit 1
	fi
	modlib_config
}

start() {
	modlib_startdaemon $DAEMON -c $CONF -d
}

case "$1" in
	""|load)
		modlib_add_user_and_group nobody
		if [ ! -d /var/run/$DAEMON ]; then
			mkdir -p /var/run/$DAEMON && chown nobody:nobody /var/run/$DAEMON
		fi
		mkdir -p /tmp/flash/$DAEMON

		modreg cgi $DAEMON "$DAEMON_LONG_NAME"
		modreg daemon $DAEMON
		modreg file $DAEMON extra 'extra' 0 mosquitto_extra

		modlib_start $MOSQUITTO_ENABLED
		;;
	unload)
		modunreg file $DAEMON
		modunreg daemon $DAEMON
		modunreg cgi $DAEMON
		modlib_stop
		;;
	start)
		modlib_start
		;;
	stop)
		modlib_stop
		;;
	restart)
		modlib_restart
		;;
	reload)
		modlib_reload
		;;
	status)
		modlib_status
		;;
	*)
		echo "Usage: $0 [load|unload|start|stop|restart|reload|status]" 1>&2
		exit 1
		;;
esac

exit 0

#!/bin/sh

. /mod/etc/conf/mosquitto.cfg

cat << EOF
user nobody
pid_file /var/run/mosquitto/mosquitto.pid
listener $MOSQUITTO_PORT
EOF

if [ "$MOSQUITTO_ALLOW_ANONYMOUS" = "yes" ]; then
	echo "allow_anonymous true"
else
	echo "allow_anonymous false"
	echo "password_file /etc/default.mosquitto/passwd"
fi

if [ -n "$MOSQUITTO_PERSISTENCE_PATH" ]; then
	echo "persistence true" && echo "persistence_location $MOSQUITTO_PERSISTENCE_PATH"
else
	echo "persistence false"
fi

if [ "$MOSQUITTO_SYSLOG" = "yes" ]; then
	echo "log_dest syslog"
	echo "log_type warning"
	echo "log_type error"
fi

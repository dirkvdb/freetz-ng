[ "$EXTERNAL_FREETZ_PACKAGE_GNUTLS_CERTTOOL"   == "y" ] && EXTERNAL_FILES+=" /usr/bin/certtool"
[ "$EXTERNAL_FREETZ_PACKAGE_GNUTLS_UTILS"      == "y" ] && EXTERNAL_FILES+=" /usr/bin/gnutls-cli /usr/bin/gnutls-serv /usr/bin/psktool /usr/bin/srptool"

[ "$FREETZ_LIB_libgnutls_WITH_VERSION_ABANDON" == "y" ] && ELIBVER="30.34.5" || ELIBVER="30.42.0"
[ "$EXTERNAL_FREETZ_LIB_libgnutls"             == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libgnutls.so.$ELIBVER"

[ "$FREETZ_LIB_libgnutls_WITH_VERSION_ABANDON" == "y" ] && ELIBVER="27.0.2"  || ELIBVER="27.2.0"
[ "$EXTERNAL_FREETZ_LIB_libgnutls_openssl"     == "y" ] && EXTERNAL_FILES+=" ${FREETZ_LIBRARY_DIR}/libgnutls-openssl.so.$ELIBVER"

